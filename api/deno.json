{
  "unstable": ["kv"],
  "tasks": {
    "check": "deno check main.ts",
    "start": "deno run --allow-net --allow-read=./client --allow-env main.ts",
    "dev": "DEV=1 KV_PATH=./.data/kv.sqlite3 deno run --allow-net --allow-read --allow-write=./.data --allow-env --allow-run --allow-ffi --allow-sys main.ts"
  },
  "fmt": {
    "lineWidth": 120,
    "semiColons": true,
    "singleQuote": true
  }
}
