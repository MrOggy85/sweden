{
  "unstable": ["kv"],
  "tasks": {
    "check": "deno check main.ts",
    "start": "KV_PATH=./.data/kv.sqlite3 deno run --allow-net --allow-read=./client,./.data --allow-write=./.data --allow-env main.ts",
    "dev": "DEV=1 KV_PATH=./.data/kv.sqlite3 deno run -A main.ts"
  },
  "fmt": {
    "lineWidth": 120,
    "semiColons": true,
    "singleQuote": true
  }
}
